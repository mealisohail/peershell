{
  "name": "@peershell/web",
  "version": "0.0.1",
  "private": true,
  "description": "Browser client for peershell",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/signaling.test.ts src/terminal/OutputBuffer.test.ts src/terminal/Session.test.ts src/terminal/PaneTree.test.ts src/terminal/SessionManager.test.ts src/state/store.test.ts",
    "test:debug": "tsx --test src/terminal/PaneTree.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
